# IdeaOS API - Local Development Environment
# Copy this file to .env and fill in your values

# App
APP_NAME=IdeaOS API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Database (PostgreSQL with pgvector)
# For local development with Docker: postgresql://postgres:postgres@localhost:5432/ideaos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ideaos
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Redis
REDIS_URL=redis://localhost:6379/0

# Supabase (for auth - use local or cloud)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_ANON_KEY=your-anon-key

# Authentication (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# AI Providers
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# Transcription
STT_PROVIDER=whisperx
WHISPERX_API_URL=
WHISPERX_API_KEY=

# Object Storage (Cloudflare R2)
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=ideaos-local
R2_PUBLIC_URL=https://xxx.r2.cloudflarestorage.com

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=

# Celery (uses Redis)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security
SECRET_KEY=your-secret-key-at-least-32-chars-long
ENCRYPTION_KEY=your-encryption-key-32-chars-long!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# File Upload
MAX_FILE_SIZE=524288000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Feature Flags
ENABLE_FUSION_ENGINE=true
ENABLE_BRAND_GUARDIAN=true
ENABLE_CALENDAR=true
ENABLE_ANALYTICS=true