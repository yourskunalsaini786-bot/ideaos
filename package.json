{
  "name": "ideaos",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --prefix apps/web",
    "dev:api": "cd apps/api && python3 -m uvicorn ideaos.main:app --reload --port 8000",
    "dev:web": "npm run dev --prefix apps/web",
    "test:api": "python3 -m pytest apps/api/tests",
    "build": "npm run build --prefix apps/web",
    "lint": "npm run lint --prefix apps/web",
    "test": "npm run test:api"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.5.0"
}
